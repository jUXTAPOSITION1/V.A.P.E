# @x402/svm's transitive @solana/kit family declares peerOptional
# typescript@^5.0.0, which conflicts with this project's pinned
# typescript@7.0.2 (see package.json). The repo's own CI already works
# around this with `npm ci --legacy-peer-deps` (worker/README.md's Solana
# section), but cloudflare/wrangler-action's internal `npm install
# wrangler@<pinned version>` step (deploy-worker.yml) runs its own bare npm
# command with no way to pass that flag -- it re-resolves the whole tree and
# fails with ERESOLVE before wrangler ever runs, silently breaking every
# real deploy since @solana/kit was added (confirmed: the last two pushes to
# main both failed here). npm reads .npmrc from the cwd for every invocation,
# so this makes the setting apply automatically regardless of who's calling
# npm in this directory.
legacy-peer-deps=true
