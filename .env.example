# V.A.P.E. + HACK — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).
# For GitHub Actions, these are set as repository Secrets instead of a file.

# ─────────────────────────────────────────────────────────────────────────────
# LLM / Inference (REQUIRED for the Python agent + SKILLFORGE synthesize)
# ─────────────────────────────────────────────────────────────────────────────
# xAI Grok 4.1 Fast — primary model for reports/investigations/expert assessment
# (agents/llm.py's FRONTIER_ORDER tries this first before falling back).
# Paid; VAPE runs fine without it (falls through to the free providers below),
# but frontier-tier calls are noticeably weaker without it set.
XAI_API_KEY_1=your_xai_key_here
# Groq — free tier, powers the default fast/bulk tier in agents/run.py & main.py
GROQ_API_KEY=gsk_your_groq_key_here
# Google Gemini — powers agent web_search intel feed (free tier; mind rate limits)
GEMINI_API_KEY=your_gemini_key_here

# Optional extra free LLM providers — agents/llm.py auto-fails-over across any that are set.
CEREBRAS_API_KEY=        # 1M tokens/day free — bulk synthesis
OPENROUTER_API_KEY=      # 20+ free models, one key — fallback marketplace
GITHUB_MODELS_TOKEN=     # GitHub Models (Azure OAI) — same CI account, no new signup
TOGETHER_API_KEY=        # free 70B endpoints — when 8B isn't enough

# Oracle Cloud hosted xAI Grok 4.3 — opt-in-only candidate (agents/llm.py::ask_oci_grok()),
# NOT on the default FRONTIER_ORDER path until wired into a real call site. Paid; the key is
# a plain Bearer secret minted in OCI's Generative AI service console — NOT the IAM RSA key
# pair (user/tenancy/fingerprint/private key) used for general OCI SDK/CLI request signing.
OCI_GENAI_API_KEY=       # Generative AI service API key (Bearer token, not the IAM key)
OCI_REGION=              # default: us-ashburn-1
OCI_GROK_MODEL=          # default: xai.grok-4.3
OCI_COMPARTMENT_OCID=    # optional — sent as a CompartmentId header if set
OCI_GROK_DAILY_SPEND_CAP_USD=  # default: 3.00 (same default as XAI_DAILY_SPEND_CAP_USD)

# ─────────────────────────────────────────────────────────────────────────────
# On-chain data (agents/investigate.py, agents/security_sweep.py, SKILLFORGE recon tier)
# ─────────────────────────────────────────────────────────────────────────────
# Base RPC endpoint (read-only). Public default works; private endpoint = higher limits
BASE_RPC_URL=https://mainnet.base.org
# Etherscan V2 multichain key — contract_recon (free tier)
# chainids: Base=8453 Eth=1 Arb=42161 Op=10 Polygon=137
ETHERSCAN_API_KEY=your_etherscan_v2_key_here
# Alchemy — wallet_trace's real Transfers API backend (Base/Eth/Arb/Op, free tier)
VAPE_TRACE_ALCHEMY_API=your_alchemy_api_key_here
# Codex.io — GraphQL on-chain data (trending tokens, holders, wallet PnL,
# launchpad activity). Free tier; agents/codex_data.py enforces its own
# conservative daily request cap (CODEX_DAILY_REQUEST_CAP, default 200 —
# 6,000/month, leaving headroom in the shared 10k/month Free-tier budget)
# so a bug can't quietly blow through the free quota.
CODEX_API_KEY=your_codex_api_key_here
CODEX_DAILY_REQUEST_CAP=200

# Hugging Face — only needed for the LoRA fine-tune pipeline (training/
# train_lora.py, .github/workflows/train-vape-model.yml) to push/pull the
# tuned model. Not used by any of the always-on agents/site/worker paths.
HF_TOKEN=your_huggingface_token_here

# ─────────────────────────────────────────────────────────────────────────────
# Wallet signing key — KEEP SECRET. Used by agents/data_agent.py to sign real
# x402 payments (DATA AGENT hiring VAPE's own market-data offerings mid-
# investigation). In production this lives ONLY in GitHub Secrets, never here.
# ─────────────────────────────────────────────────────────────────────────────
DATA_AGENT_PRIVATE_KEY=0x_your_data_agent_private_key

# GITHUB_TOKEN is injected automatically by GitHub Actions — do not set it here.

# ─────────────────────────────────────────────────────────────────────────────
# MCP community research/scrape servers (OPTIONAL). VAPE hosts these via
# skillforge/mcp_client.py + mcp_servers/registry.json. Each activates the
# instant its key is set — no code change. Without keys, VAPE uses keyless
# fallbacks (MCP fetch + public search). Set only the ones you have.
# ─────────────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=              # https://tavily.com/          (AI search + extract)
BRAVE_API_KEY=               # https://brave.com/search/api (web/news search)
FIRECRAWL_API_KEY=           # https://www.firecrawl.dev/   (deep crawl/scrape)
APIFY_TOKEN=                 # https://apify.com/           (actors / structured extract)
BRIGHTDATA_API_TOKEN=        # https://brightdata.com/      (unblockable web access)
